# ============================================================================
# StreetReaderAI — Providers, Models & API Keys Configuration (models.conf)
# ============================================================================
# Copy this file to `models.conf` (which is git-ignored) and set your API keys
# and active providers below. This file is read strictly on the Node.js server
# (`src/server.ts`) so API keys are never exposed to the browser.
# In Google AI Studio, GEMINI_API_KEY is injected automatically by the host.

[providers]
# Active AI provider for scene description & Q&A: gemini | openai
ai_provider = gemini

# Active street-level imagery & location providers
imagery_provider = panoramax
location_provider = osm

[models]
# Multimodal Vision / Chat models
gemini_model = gemini-3.8-flash
openai_model = gpt-5.6-terra

[keys]
gemini_api_key =
openai_api_key =
mapillary_token =
google_maps_api_key =
